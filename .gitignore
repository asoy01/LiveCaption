.pixi/
__pycache__/
*.pyc
# Every .env variant holds secrets. Only the sample is published.
.env*
!.env.example

# The rendered documentation site (built by CI).
site/

# local files
local/
# Scratch audio and other local working files.
data/

# Glossary tables. **Never share these.** They hold personal and organisation
# names, and their contents are specific to your own field.
# The sample is docs/glossary-example.tsv.
# Keep the folder itself, or there is nowhere to copy the sample to.
etc/glossary/*
!etc/glossary/.gitkeep

# Notes for Claude Code. They refer to local/HANDOFF.md, which is not published.
.claude/
