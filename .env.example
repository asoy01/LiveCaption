# Copy this file to .env and fill in the values.
# .env is listed in .gitignore.
#
# The value in .env wins over the environment variable of the same name.

# OpenAI. Speech recognition and translation both use it.
# This is the only key LiveCaption needs.
OPENAI_API_KEY=

# Deepgram. NOT needed to run LiveCaption.
# Only these three comparison scripts use it:
#   scripts/deepgram_check.py
#   scripts/deepgram_keyterm_test.py
#   scripts/transcribe_all.py
# They were used to compare recognisers. Deepgram was not chosen: its keyterm
# prompting does not work for Japanese. Leave this empty unless you run them.
DEEPGRAM_API_KEY=
