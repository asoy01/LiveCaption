# Copy this file to .env and fill in the values.
# Keep .env in this folder, the top of the repository, next to pixi.toml.
# .env is listed in .gitignore.
#
# The value in .env wins over the environment variable of the same name.

# OpenAI. Transcription and translation both use it.
# This is the only key LiveCaption needs.
OPENAI_API_KEY=


# --- What your meetings are about (optional, but worth setting) -------------
# One sentence describing the field your meetings belong to. It goes into both
# the transcription prompt and the translation prompt, and it tells the models
# which field a technical term belongs to.
#
# The default does not name any field, which works but gets technical terms
# wrong more often. Write your own:
#
#   LIVECAPTION_MEETING_CONTEXT=A weekly meeting about radio astronomy. Topics include receivers, calibration and observation scheduling.
#
# This is not the same as the glossary. The glossary gives the translation of
# one term; this sentence tells the model which field to read every term in.
# Write it in the language the meeting is mostly held in.
#LIVECAPTION_MEETING_CONTEXT=


# --- Tailscale, when you run LiveCaption in Docker (optional) ---------------
# Leave this empty to log in by hand: `docker compose logs` prints a URL you
# open in a browser. Nothing secret then lives in this file.
#
# To join without a browser, create an auth key in the Tailscale admin console
# (Settings -> Keys -> Generate auth key):
#
#   Reusable   on    you need it again whenever you recreate the volume
#   Ephemeral  off   an ephemeral node changes its name every time, and the
#                    viewer URL you handed out in advance stops working
#   Tags       tag:livecaption
#
# The tag must exist in your ACL first, and Funnel needs the node attribute:
#
#   "tagOwners": { "tag:livecaption": ["autogroup:admin"] },
#   "nodeAttrs": [ { "target": ["tag:livecaption"], "attr": ["funnel"] } ]
#
# A tagged device is no longer part of autogroup:member, so without that
# nodeAttrs line it loses Funnel. A tagged device also never expires, which
# is why we tag it.
#
# If your tailnet has Tailnet Lock enabled, sign the key on a machine that
# already holds a trusted signing key, and use the signed key below:
#
#   sudo tailscale lock sign tskey-auth-xxxxxxxx
#
# An unsigned node is registered but cannot talk to any other node.
#TS_AUTHKEY=

# The name of the container on your tailnet. Changing it kills the viewer URL
# you already handed out. Default: livecaption
#
# Give each machine its own name. Two containers that ask for the same name
# do not share it: the second one is renamed to livecaption-1, and its viewer
# URL is not the one you handed out.
#TS_HOSTNAME=livecaption

# What Docker does when the container stops. This is a Docker restart policy,
# and it is also what the control page reads to decide whether its button says
# "Quit" or "Restart".
#
#   unless-stopped   the default. Use it on a machine that stays on. The
#                    container comes back after a reboot, and after you press
#                    Quit on the control page. `docker compose stop` still
#                    keeps it down.
#   no               use it on a laptop that you start for a meeting and then
#                    shut down. Without this, LiveCaption starts every time
#                    Docker Desktop starts, and joins any meeting you have
#                    scheduled.
#LIVECAPTION_RESTART=unless-stopped

# Start VNC together with the container. You need VNC to sign in to Zoom, and
# to look at the meeting client when joining gets stuck.
#
# There is no password on it, so leave this at 0 and start VNC from the
# control page (Setup -> VNC) for the few minutes you need it.
#LIVECAPTION_VNC=0


# --- Where the glossaries are kept (optional) -------------------------------
# The term tables live in etc/glossary/ inside the repository. You edit them
# with a text editor there.
#
# Set this when you manage the tables from the control page instead (upload,
# download, delete). In Docker this points inside a volume, so a table you
# upload survives recreating the container. The folder is created if it does
# not exist, and the tables shipped with the image are copied in once, when it
# is still empty.
#LIVECAPTION_GLOSSARY_DIR=


# --- Where the meeting record is written (optional) -------------------------
# The record of each meeting is written to local/transcripts/ inside the
# repository. You download it from the control page, so you do not have to
# reach the caption PC to read it.
#
# Set this to keep the records outside the repository, for example when the
# repository sits in a synced folder (Dropbox, OneDrive) and you do not want
# every meeting uploaded. The folder is created if it does not exist.
#LIVECAPTION_SAVE_DIR=%LOCALAPPDATA%\LiveCaption\transcripts


# --- Tuning (optional) ------------------------------------------------------
# The defaults below were chosen from measurements on real meeting audio.
# Leave them out unless you have a reason. An unreadable or too-small value is
# reported at start-up and ignored, so a typo here cannot stop a meeting.

# Seconds of silence after which a sentence is finalised without an end mark.
# Measured delta intervals during continuous speech have a p99 of 2.57 s, so
# a value below that cuts speakers off mid-sentence. Default 2.5.
#LIVECAPTION_IDLE_FLUSH_SEC=2.5

# Seconds of silence after which the translation is sent without waiting for
# the sentence to be finalised. Default 1.4. Set 0 to turn it off.
# If you change IDLE_FLUSH_SEC and leave this out, it follows automatically.
#LIVECAPTION_SPECULATE_AFTER_SEC=1.4

# A Japanese sentence longer than this is cut. Lower it if captions go by too
# fast to read. Default 70.
#LIVECAPTION_FORCE_CUT_CHARS=70

# Gap between lines sent to Zoom. The Zoom caption area shows as few as 4
# lines, so sending them at once pushes the first line out. Default 0.6.
# It does not apply to the viewer page, which gets every line at once.
#LIVECAPTION_LINE_INTERVAL_SEC=0.6
