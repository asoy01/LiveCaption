# What to keep out of the Docker build context.
#
# **Always keep `.env` out.** Even if you never COPY it, anything in the
# context can be baked in by accident. The key then stays in an image layer
# and cannot be removed.
.env

# History, and the pixi environment on the host. The container builds its own.
.git/
.git-rewrite/
.pixi/

# Python intermediate files.
__pycache__/
**/__pycache__/
*.pyc

# Work files and recordings. **`local/` is several hundred MB.** Pass test
# audio in on a volume.
local/
data/

# Windows-only entry points. The container does not use them.
*.bat
*.vbs
*.ps1
